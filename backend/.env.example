# ==============================================================================
# Football Copilot - Backend Environment Configuration Template
# ==============================================================================
# NOTE: Do NOT commit your actual .env file with real secrets to version control.
# Copy this file to .env and provide your deployment-specific credentials.

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development # Options: development, staging, production

# ------------------------------------------------------------------------------
# 2. CORS & Client Origins
# ------------------------------------------------------------------------------
# For production, set to your frontend domain(s). Supports comma-separated list.
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Optional regex for dynamic deployment previews (e.g., ^https:\/\/.*\.vercel\.app$)
# ALLOWED_ORIGIN_REGEX=^https:\/\/.*\.vercel\.app$

# ------------------------------------------------------------------------------
# 3. Database Credentials
# ------------------------------------------------------------------------------
# MongoDB connection string (Local or MongoDB Atlas)
MONGO_URI=mongodb://localhost:27017/football-copilot
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/football-copilot?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 4. Authentication (JWT Secrets)
# ------------------------------------------------------------------------------
# Generate strong 256-bit random strings for production (e.g. `openssl rand -hex 32`)
JWT_SECRET=your_super_secret_jwt_access_key_here
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_here

# ------------------------------------------------------------------------------
# 5. External Football Data Providers
# ------------------------------------------------------------------------------
# football-data.org API Key (v4)
FOOTBALL_DATA_API_KEY=your_football_data_api_key_here

# RapidAPI Live Football Data
RAPID_API_KEY=your_rapidapi_key_here
RAPID_API_HOST=free-api-live-football-data.p.rapidapi.com

# ------------------------------------------------------------------------------
# 6. Google Gemini AI Engine
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_LITE_MODEL=gemini-2.0-flash-lite

# ------------------------------------------------------------------------------
# 7. Qdrant Vector Database (RAG & Memory Embeddings)
# ------------------------------------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY= # Leave empty for local instance without authentication
QDRANT_COLLECTION=football_knowledge
QDRANT_FACTS_COLLECTION=user_facts_memory
QDRANT_EPISODIC_COLLECTION=user_episodic_memory
QDRANT_SCOUT_COLLECTION=player_scout_vectors

# ------------------------------------------------------------------------------
# 8. Redis Caching & Queue
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# 9. Cloudinary Media Storage (Avatars & Scans)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------------------------
# 10. Web Push Notifications (VAPID Keys)
# ------------------------------------------------------------------------------
# Generate keys with: `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
